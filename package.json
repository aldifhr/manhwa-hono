{
  "name": "manhwa-hono",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Manhwa chapter tracker on Cloudflare Workers — Hono port of manhwa-scanner's Python backend",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 execute manhwa --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute manhwa --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.4",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.147.0"
  }
}
